# Supabase project — get these from your Supabase dashboard → Project Settings → API
# The anon key is public by design (safe in the browser) and protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# n8n webhook that persists an order status change (Cocinar / Listo / Entregar).
# The instance moved from Hostinger to Contabo, so this is no longer hardcoded.
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://n8n.gercio.site/webhook/update-order-status
